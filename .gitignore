# ==========================================
# HOME CAR CLEAN
# Files that must NEVER be uploaded to GitHub
# ==========================================

# Environment variables / secrets
.env
.env.*
!.env.example

# Private keys / certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# Node dependencies
node_modules/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Operating system junk
.DS_Store
Thumbs.db

# Local editor/settings files
.vscode/
.idea/
